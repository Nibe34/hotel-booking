meta {
  name: Idempotency - повтор з тим самим ключем
  type: http
  seq: 12
}

post {
  url: {{app}}/api/bookings
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{idemKey}}
}

auth:bearer {
  token: {{bobToken}}
}

body:json {
  {
    "roomId": {{roomId}},
    "checkIn": "2030-06-10",
    "checkOut": "2030-06-12",
    "guestsCount": 1
  }
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });

  test("same booking returned, no second one", function () {
    expect(res.body.id).to.equal(bru.getVar("idemId"));
  });
}

docs {
  Клієнт повторив запит (наприклад, після таймауту). @Around повернув збережену відповідь,
  метод не викликався - тому немає 409 і немає другого бронювання.
}
