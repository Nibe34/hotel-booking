meta {
  name: thenCombine - рахунок у USD
  type: http
  seq: 2
}

get {
  url: {{app}}/api/bookings/{{b5}}/invoice?currency=USD
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bobToken}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("invoice + converted price combined", function () {
    expect(res.body.invoiceNumber).to.match(/^INV-/);
    expect(res.body.convertedTotal).to.be.a("number");
  });

  test("calls ran in parallel (< 1.5 s, sequential would be ~1.7 s)", function () {
    expect(res.getResponseTime()).to.be.below(1500);
  });
}

docs {
  Подивись на час відповіді: ~1 с. Послідовно було б 1 + 0.7 = 1.7 с.
}
