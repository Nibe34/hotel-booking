docs {
  @ValidStayPeriod - Bean Validation constraint (domain/annotation, domain/validation/StayPeriodValidator).
  @PostCreated - композитна: @RequestMapping(POST) + @ResponseStatus(CREATED) (web/annotation).
  @CurrentUsername - резолвер аргументів: ім'я з JWT підставляється в параметр контролера (web/CurrentUsernameArgumentResolver).
}
