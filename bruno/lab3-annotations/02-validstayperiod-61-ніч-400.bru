meta {
  name: ValidStayPeriod - 61 ніч - 400
  type: http
  seq: 2
}

post {
  url: {{app}}/api/bookings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bobToken}}
}

body:json {
  {
    "roomId": {{roomId}},
    "checkIn": "2030-03-01",
    "checkOut": "2030-05-01",
    "guestsCount": 1
  }
}

tests {
  test("status 400", function () {
    expect(res.status).to.equal(400);
  });

  test("names nights and the limit", function () {
    expect(res.body.fieldErrors.checkOut).to.contain("stay of 61 nights");
    expect(res.body.fieldErrors.checkOut).to.contain("maximum of 30 nights");
  });
}
