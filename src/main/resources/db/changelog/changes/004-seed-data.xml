<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-seed-hotels" author="student">
        <insert tableName="hotels">
            <column name="name" value="Dnipro Riverside"/>
            <column name="city" value="Kyiv"/>
            <column name="address" value="Naberezhne shose 2"/>
            <column name="stars" valueNumeric="4"/>
            <column name="description" value="Hotel on the bank of the Dnipro with a view of the Left Bank"/>
        </insert>
        <insert tableName="hotels">
            <column name="name" value="Old Town Inn"/>
            <column name="city" value="Lviv"/>
            <column name="address" value="Rynok Square 10"/>
            <column name="stars" valueNumeric="3"/>
            <column name="description" value="Cozy inn in the historic centre"/>
        </insert>
        <insert tableName="hotels">
            <column name="name" value="Black Sea Resort"/>
