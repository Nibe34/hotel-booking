            <column name="address" value="Frantsuzkyi bulvar 33"/>
            <column name="stars" valueNumeric="5"/>
            <column name="description" value="Seaside resort with private beach"/>
        </insert>
    </changeSet>

    <changeSet id="004-seed-rooms" author="student">
        <insert tableName="rooms">
