        <insert tableName="rooms">
            <column name="hotel_id" valueComputed="(SELECT id FROM hotels WHERE name = 'Dnipro Riverside')"/>
            <column name="room_number" value="102"/>
            <column name="room_type" value="DOUBLE"/>
            <column name="capacity" valueNumeric="2"/>
            <column name="price_per_night" valueNumeric="2600.00"/>
        </insert>
        <insert tableName="rooms">
            <column name="hotel_id" valueComputed="(SELECT id FROM hotels WHERE name = 'Dnipro Riverside')"/>
            <column name="room_number" value="301"/>
            <column name="room_type" value="SUITE"/>
            <column name="capacity" valueNumeric="4"/>
            <column name="price_per_night" valueNumeric="6500.00"/>
