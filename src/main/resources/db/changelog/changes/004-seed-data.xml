        <insert tableName="rooms">
            <column name="hotel_id" valueComputed="(SELECT id FROM hotels WHERE name = 'Black Sea Resort')"/>
            <column name="room_number" value="505"/>
            <column name="room_type" value="SUITE"/>
            <column name="capacity" valueNumeric="3"/>
            <column name="price_per_night" valueNumeric="9900.00"/>
        </insert>
    </changeSet>

</databaseChangeLog>
