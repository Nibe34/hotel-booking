        <insert tableName="rooms">
            <column name="hotel_id" valueComputed="(SELECT id FROM hotels WHERE name = 'Old Town Inn')"/>
            <column name="room_number" value="1"/>
            <column name="room_type" value="DOUBLE"/>
            <column name="capacity" valueNumeric="2"/>
